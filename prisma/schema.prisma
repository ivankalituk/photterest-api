generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum MediaType {
  IMAGE
  VIDEO
  MUSIC
  DOCUMENT
  OTHER
}


model users {
  id            String   @id @default(uuid()) @db.Uuid

  nickname      String   @unique @db.VarChar(255)
  email         String   @unique @db.VarChar(255)

  password_hash String?
  google_id     String?  @unique @db.VarChar(255)
  birth_date    DateTime? @db.Date

  avatar_url    String?
  role          String   @default("user") @db.VarChar(20)

  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  boards        boards[]
  pins          pins[]
}

model boards {
  id                String       @id @default(uuid()) @db.Uuid
  name              String       @db.VarChar(30)
  creator_id        String       @db.Uuid

  private           Boolean      @default(false)
  deleted           Boolean      @default(false)

  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @updatedAt @db.Timestamptz(6)
  inner_updated_at  DateTime @default(now()) @db.Timestamptz(6)

  creator users @relation(fields: [creator_id], references: [id])
  origin_pins pins[]
  board_pins board_pins[]
}

model media {
  id              String      @id @default(uuid()) @db.Uuid
  filename        String      @unique @db.VarChar(255)
  original_name   String?     @db.VarChar(255)
  mime_type       String      @db.VarChar(150)
  type            MediaType
  size            Int
  path            String      @db.VarChar(255)

  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @updatedAt @db.Timestamptz(6)

  pin_media       pin_media[]
}

model pins {
  id                String      @id @default(uuid()) @db.Uuid
  name              String      @db.VarChar(255)
  description       String?     @db.Text
  link              String?     @db.VarChar(2048)
  origin_board_id   String      @db.Uuid
  tags              String[]    @db.VarChar(255)
  ai_changed        Boolean     @default(false)
  ai_people_changed Boolean     @default(false)
  allow_comments    Boolean     @default(false)
  creator_id        String      @db.Uuid

  media             pin_media[]

  created_at        DateTime    @default(now()) @db.Timestamptz(6)
  updated_at        DateTime    @updatedAt @db.Timestamptz(6)

  creator           users       @relation(fields: [creator_id], references: [id])
  origin_board      boards      @relation(fields: [origin_board_id], references: [id])
  board_pins board_pins[]
}

model pin_media {
  id        String   @id @default(uuid()) @db.Uuid
  pin_id    String   @db.Uuid
  media_id  String   @db.Uuid

  pin       pins     @relation(fields: [pin_id], references: [id], onDelete: Cascade)
  media     media    @relation(fields: [media_id], references: [id], onDelete: Cascade)

  @@unique([pin_id, media_id])
}

model board_pins {
  id        String   @id @default(uuid()) @db.Uuid
  pin_id    String   @db.Uuid
  board_id  String   @db.Uuid

  pin       pins     @relation(fields: [pin_id], references: [id], onDelete: Cascade)
  board     boards   @relation(fields: [board_id], references: [id], onDelete: Cascade)

  @@unique([pin_id, board_id])
}